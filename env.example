# Azure Document Intelligence
DOC_INTEL_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-01
EMBEDDING_DEPLOYMENT=text-embedding-3-small
CHAT_DEPLOYMENT=gpt-4o

# Azure Blob Storage
# The storage account is taken from AccountName below, or set BLOB_ACCOUNT_URL /
# STORAGE_ACCOUNT_NAME explicitly. It must never be hard-coded in source.
BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
BLOB_CONTAINER_NAME=parent-chunks
# BLOB_ACCOUNT_URL=https://<your-account>.blob.core.windows.net
# STORAGE_ACCOUNT_NAME=<your-account>

# Ingestion pipeline layout (defaults shown)
INGESTION_CONTAINER=ingestion-pipeline
SOURCE_DOCUMENT_PREFIX=source-documents
SOURCE_DOCUMENT=breakdown_policy_booklet.pdf
EXTRACTED_MARKDOWN_PREFIX=extracted-markdowns
CLEAN_MARKDOWN_PREFIX=clean-markdowns
CHUNK_PREFIX=chunks
PARENT_CHUNK_PREFIX=parent-chunks

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_SEARCH_INDEX_NAME=breakdown-child-chunks

# Azure AI Content Safety — groundedness checking of generated answers
AZURE_CONTENT_SAFETY_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_CONTENT_SAFETY_KEY=
# Check the answer against all retrieved sections (default) or only the top one
GROUNDEDNESS_SOURCES=all
GROUNDEDNESS_ENABLED=true

ADMIN_API_URL=
RAG_API_URL=